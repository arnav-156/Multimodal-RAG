# Optional overrides. Relative paths resolve beside the selected YAML file.
# Copy only the variables you need; do not commit credentials.
# RAG_CONFIG=D:/path/to/my-config.yaml
# DB_PATH=D:/path/to/index.db
# LOG_DIR=D:/path/to/logs
# RAG_HOST=127.0.0.1
# RAG_PORT=8100
# VLLM_API_URL=http://127.0.0.1:8001
# VLLM_MODEL_NAME=jinaai/jina-embeddings-v5-text-small-retrieval
# OCR_API_URL=http://127.0.0.1:8002
# JINA_MODEL_PATH=D:/path/to/local/checkpoint
# RAG_API_TOKEN must be at least 32 characters; omit to use the private token file.
# Vision credentials may use api_key_env in an explicit endpoint configuration.
# Neither credentials nor environment variables authorize cloud transmission.
